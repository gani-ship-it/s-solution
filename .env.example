# =====================================================================
# AI Research Agent Configuration (.env)
# =====================================================================

# LLM Provider: 'groq' (recommended for free/fast inference) or 'openai'
LLM_PROVIDER=groq

# Groq API Key (paste your Groq key starting with gsk_ here)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Name (e.g. openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b)
MODEL_NAME=openai/gpt-oss-120b

# OpenAI API Key (optional if using Groq)
OPENAI_API_KEY=

# Model Temperature (0.0 to 1.0)
TEMPERATURE=0.2

# Maximum autonomous step budget
MAX_STEPS=8

# Web Search Provider (duckduckgo is free & keyless)
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# Webpage Fetcher Settings
FETCH_TIMEOUT=10
MAX_CONTENT_CHARS=6000
