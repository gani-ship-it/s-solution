{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": [
        "src/**",
        "static/**",
        "web_app.py"
      ],
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
